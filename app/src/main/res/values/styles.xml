
<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Existing app theme -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#16866A</item>

        <!-- Light mint-green status bar -->
        <item name="android:statusBarColor">#EAF8F0</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- White bottom navigation bar -->
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- Splash screen shown when the app launches -->
    <style name="Theme.TEXLearn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
